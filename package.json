{
  "name": "visual-regression-testing-vue-card-simple",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test --update-snapshots",
    "test:report": "playwright show-report",
    "test:docker": "docker compose run --rm playwright || playwright show-report",
    "test:docker:update": "docker compose run --rm playwright bash -c \"npm ci && npx playwright test --update-snapshots\""
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.6"
  }
}
